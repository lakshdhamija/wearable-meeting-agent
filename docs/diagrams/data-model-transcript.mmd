erDiagram
  direction TB
  USER ||--o{ PERSON : names
  RECORDING ||--o{ SPEAKER : has
  RECORDING ||--o{ SEGMENT : "transcribed into"
  RECORDING ||--o{ SUMMARY : "summarized in"
  PERSON |o--o{ SPEAKER : "attributed to"
  SPEAKER ||--|{ SEGMENT : says
  PERSON {
    uuid id PK
    uuid user_id FK
    text display_name
  }
  SPEAKER {
    uuid recording_id PK, FK
    text label PK
    uuid person_id FK "null until named"
    text state "wearer, named, unknown"
    float score
    text decided_by "system, wearer"
  }
  SEGMENT {
    bigint id PK
    uuid recording_id FK
    text speaker_label FK
    int start_ms
    int end_ms
    text text
    bool overlapped
  }
  SUMMARY {
    uuid recording_id PK, FK
    int version PK
    jsonb claims "each claim cites segment ids"
  }
