erDiagram
  VOICE ||--|{ CONTRIBUTION : "built from"
  VOICE {
    uuid id PK
    uuid user_id
    uuid person_id "the person the wearer named"
    text kind "wearer, other"
    bytea voiceprint "weighted mean of its evidence, encrypted with the voice's key"
    timestamptz last_heard_at
  }
  CONTRIBUTION {
    uuid voice_id PK, FK
    uuid recording_id PK
    text speaker_label PK
    bytea embedding "encrypted with the voice's key"
    float speech_seconds
    jsonb ranges "time ranges of its speech"
    bool from_naming "the wearer's own naming, never evicted"
  }
